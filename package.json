{
  "name": "pi-pretty-task",
  "version": "1.2.0",
  "description": "Background processes, log tails and scheduled agent wake-ups for pi, behind one panel.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "background-tasks",
    "process-manager",
    "dev-server",
    "log-tail",
    "scheduler",
    "cron",
    "loop",
    "subprocess"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mystery4f/pi-pretty-task.git"
  },
  "homepage": "https://github.com/mystery4f/pi-pretty-task#readme",
  "bugs": {
    "url": "https://github.com/mystery4f/pi-pretty-task/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/mystery4f/pi-pretty-task/main/docs/preview.png",
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "skills",
    "docs/preview.png",
    "docs/preview.gif",
    "docs/preview-iteration.png",
    "docs/preview-tail.png",
    "docs/preview-chain.png",
    "docs/preview-cmdloop.png",
    "docs/preview-failed.png",
    "docs/preview-search.png",
    "docs/preview-detach.png",
    "docs/preview-cards.png",
    "docs/preview-status.png"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.dev.json",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:watch": "vitest",
    "verify": "npm run check && npm run lint && npm test",
    "preview": "npm run build && node scripts/preview/preview.mjs",
    "preview:dump": "node scripts/preview/dump.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "typebox": ">=1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^26.6.6",
    "gifenc": "^1.0.3",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "typebox": "^1.4.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
