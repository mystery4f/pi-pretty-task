{
  "name": "pi-pretty-task",
  "version": "1.0.4",
  "description": "Background processes and scheduled agent wake-ups for pi, behind one panel.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "bg",
    "background-tasks",
    "process-manager",
    "scheduler",
    "cron",
    "loop"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mystery4f/pi-pretty-task.git"
  },
  "homepage": "https://github.com/mystery4f/pi-pretty-task#readme",
  "bugs": {
    "url": "https://github.com/mystery4f/pi-pretty-task/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/mystery4f/pi-pretty-task/main/docs/preview.png",
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "skills",
    "docs/preview.png"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.dev.json",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:watch": "vitest",
    "verify": "npm run check && npm run lint && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "typebox": ">=1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^26.6.6",
    "typebox": "^1.4.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
