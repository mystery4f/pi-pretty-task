root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{ts,tsx,js,mjs,cjs,json,jsonc,css,scss,html,yml,yaml}]
indent_size = 2

[*.md]
# Trailing spaces are meaningful in markdown (hard line breaks).
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab
